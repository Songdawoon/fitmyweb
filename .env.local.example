# ── PortOne V1 (구 아임포트) credentials ────────────────────────────
# 포트원 콘솔(https://admin.portone.io) → 결제 연동 → 연동 정보에서 발급.
# 실제 키는 .env.local 에만 넣고 절대 커밋하지 마세요.

# 가맹점 식별코드 (공개되어도 되는 값)
# [식별코드 · API Keys] 탭 → 고객사 식별코드 (imp 로 시작)
NEXT_PUBLIC_PORTONE_IMP_CODE=imp00000000

# 결제 채널 지정 — 아래 둘 중 하나만 채우면 됩니다 (채널키가 우선).
#
# 1) 채널키 (권장). [채널 관리] 탭에서 V1 결제 모듈로 만든 채널의 "채널키".
#    포트원은 pg 파라미터를 deprecated 처리하고 채널키 사용을 권장합니다.
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
#
# 2) pg 코드 (레거시). 채널키를 쓰지 않을 때만.
#    NHN KCP 일반결제는 `kcp.{사이트코드}` 형식입니다. 예) kcp.T0000
#    등록된 PG 가 하나뿐이면 사이트코드 없이 `kcp` 만 써도 동작합니다.
NEXT_PUBLIC_PORTONE_PG=

# 서버 결제 검증용 REST API 키/시크릿 (절대 노출 금지)
# [식별코드 · API Keys] 탭 → V1 API Keys
PORTONE_IMP_KEY=your-portone-v1-rest-api-key
PORTONE_IMP_SECRET=your-portone-v1-rest-api-secret

# ── 웹훅 ────────────────────────────────────────────────────────────
# 콘솔 [결제알림(Webhook) 관리] → [결제 모듈 V1] 에 아래 주소를 등록하세요.
#   https://{도메인}/api/payment/webhook
# V1 웹훅에는 서명이 없어 별도 시크릿이 없습니다. 서버가 imp_uid 로 결제 건을
# 다시 조회해 위조 요청을 걸러냅니다.

# ── 알림 메일 (Resend) ──────────────────────────────────────────────
# 상담 신청과 결제 완료를 담당자 메일로 보냅니다. DB 가 없으므로 이 메일이
# 유일한 보존 수단입니다. 셋 중 하나라도 비면 발송하지 않고 로그만 남깁니다.
#
# 1) https://resend.com 가입 → API Keys 에서 발급
RESEND_API_KEY=your-resend-api-key
#
# 2) 발신 주소. Resend 에서 도메인(myfitweb.kr)을 인증한 뒤 그 도메인 주소를
#    써야 합니다. 인증 전 테스트는 onboarding@resend.dev 로 가능합니다.
CONTACT_FROM_EMAIL=marketing@myfitweb.kr
#
# 3) 수신 주소. 콤마로 여러 명을 넣을 수 있습니다.
CONTACT_TO_EMAIL=hello@myfitweb.kr
