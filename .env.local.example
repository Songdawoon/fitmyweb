# ── PortOne V1 (구 아임포트) credentials ────────────────────────────
# 포트원 콘솔(https://admin.portone.io) → 결제 연동 → 연동 정보에서 발급.
# 실제 키는 .env.local 에만 넣고 절대 커밋하지 마세요.

# 가맹점 식별코드 (공개되어도 되는 값)
# [식별코드 · API Keys] 탭 → 고객사 식별코드 (imp 로 시작)
NEXT_PUBLIC_PORTONE_IMP_CODE=imp00000000

# 결제 채널 지정 — 아래 둘 중 하나만 채우면 됩니다 (채널키가 우선).
#
# 1) 채널키 (권장). [채널 관리] 탭에서 V1 결제 모듈로 만든 채널의 "채널키".
#    포트원은 pg 파라미터를 deprecated 처리하고 채널키 사용을 권장합니다.
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
#
# 2) pg 코드 (레거시). 채널키를 쓰지 않을 때만.
#    NHN KCP 일반결제는 `kcp.{사이트코드}` 형식입니다. 예) kcp.T0000
#    등록된 PG 가 하나뿐이면 사이트코드 없이 `kcp` 만 써도 동작합니다.
NEXT_PUBLIC_PORTONE_PG=

# 서버 결제 검증용 REST API 키/시크릿 (절대 노출 금지)
# [식별코드 · API Keys] 탭 → V1 API Keys
PORTONE_IMP_KEY=your-portone-v1-rest-api-key
PORTONE_IMP_SECRET=your-portone-v1-rest-api-secret

# ── 웹훅 ────────────────────────────────────────────────────────────
# 콘솔 [결제알림(Webhook) 관리] → [결제 모듈 V1] 에 아래 주소를 등록하세요.
#   https://{도메인}/api/payment/webhook
# V1 웹훅에는 서명이 없어 별도 시크릿이 없습니다. 서버가 imp_uid 로 결제 건을
# 다시 조회해 위조 요청을 걸러냅니다.

# ── 알림 메일 (Resend) ──────────────────────────────────────────────
# 상담 신청과 결제 완료를 담당자 메일로 보냅니다. DB 가 없으므로 이 메일이
# 유일한 보존 수단입니다. 셋 중 하나라도 비면 발송하지 않고 로그만 남깁니다.
#
# 1) https://resend.com 가입 → API Keys 에서 발급
RESEND_API_KEY=your-resend-api-key
#
# 2) 발신 주소. Resend 에서 도메인(myfitweb.kr)을 인증한 뒤 그 도메인 주소를
#    써야 합니다. 인증 전 테스트는 onboarding@resend.dev 로 가능합니다.
CONTACT_FROM_EMAIL=marketing@myfitweb.kr
#
# 3) 수신 주소. 콤마로 여러 명을 넣을 수 있습니다.
CONTACT_TO_EMAIL=hello@myfitweb.kr

# ── 소셜 로그인 (NextAuth) ──────────────────────────────────────────
# 세션 암호화 키. 아무 값이나가 아니라 아래 명령으로 생성한 난수를 쓰세요.
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# 배포 도메인. 로컬은 http://localhost:3000, 운영은 실제 주소.
# Vercel 에서는 자동 감지되지만 커스텀 도메인을 쓰면 명시하는 편이 안전합니다.
NEXTAUTH_URL=http://localhost:3000

# 1) 구글 — https://console.cloud.google.com/apis/credentials
#    "사용자 인증 정보 만들기 → OAuth 클라이언트 ID → 웹 애플리케이션"
#    승인된 리디렉션 URI 에 아래를 등록:
#      http://localhost:3000/api/auth/callback/google
#      https://{운영도메인}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 2) 카카오 — https://developers.kakao.com/console/app
#    내 애플리케이션 → 앱 설정 → 앱 키의 "REST API 키" 가 CLIENT_ID 입니다.
#    카카오 로그인 → 활성화 ON, Redirect URI 에 아래를 등록:
#      http://localhost:3000/api/auth/callback/kakao
#      https://{운영도메인}/api/auth/callback/kakao
#    보안 → Client Secret 을 생성해 "사용함" 으로 두고 값을 넣습니다.
#    동의항목에서 닉네임·이메일을 "필수 동의" 로 설정해야 이름/메일이 들어옵니다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 관리자 페이지(/admin) 접근을 허용할 이메일. 콤마로 여러 개.
ADMIN_EMAILS=

# ── 데이터베이스 (Neon Postgres) ────────────────────────────────────
# Vercel → Storage → Neon 연동 시 자동 주입됩니다. 로컬에서는 Neon 콘솔의
# connection string 을 그대로 붙여넣으세요.
# 비어 있으면 로그인은 되지만 쿠폰·내역 저장이 비활성화됩니다.
#
# 스키마 반영:  npm run db:push   (또는 drizzle/0000_*.sql 을 직접 실행)
DATABASE_URL=
